# ═══════════════════════════════════════════════════════════════════
#  .env – IBKR MCP Stack Configuration
#
#  SETUP:
#    1.  cp .env.example .env
#    2.  Fill in all required fields (no defaults!)
#    3.  Generate token: openssl rand -hex 32
#    4.  docker compose up -d
#
#  Switch between Paper and Live:
#    Change only TRADING_MODE and IB_GATEWAY_PORT, then:
#    docker compose up -d --force-recreate ib-gateway ibkr-mcp-server
# ═══════════════════════════════════════════════════════════════════

# ── IBKR Credentials (required) ───────────────────────────────────
TWS_USERID=
TWS_PASSWORD=

# ── Trading Mode (required) ───────────────────────────────────────
# paper → Simulated account (safe for testing)
# live  → Real account (use with caution!)
TRADING_MODE=paper

# ── IB Gateway API Port (required – must match TRADING_MODE!) ─────
# Paper account: 4004
# Live account:  4003
#
# IMPORTANT: When TRADING_MODE is changed, this port
#            must be updated as well!
IB_GATEWAY_PORT=4004

# ── Security: Read-Only API (required) ────────────────────────────
# yes → No trade orders possible (RECOMMENDED, especially for live!)
# no  → Trade orders possible (only when explicitly needed)
#
# For live account: ALWAYS yes!
READ_ONLY_API=yes

# ── Trading Functions (required if orders are needed) ─────────────
# true  → place_order, cancel_order, modify_order etc. are active
# false → all write tools are rejected immediately in server.py
#         (double protection in addition to READ_ONLY_API)
#
# Recommended combinations:
#   Paper testing with orders:  READ_ONLY_API=no  + TRADING_ENABLED=true
#   Production read-only:       READ_ONLY_API=yes + TRADING_ENABLED=false
TRADING_ENABLED=false

# ── IB Gateway Settings ───────────────────────────────────────────
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
AUTO_RESTART_TIME=23:45
TIME_ZONE=Europe/Berlin

# VNC password for visual access to IB Gateway (debugging)
# Leave empty = no VNC server started
VNC_SERVER_PASSWORD=

# ── MCP Bearer Token (required) ───────────────────────────────────
# Protects /mcp* (Perplexity, OpenAI API) and /mcpo* (Open-WebUI)
# Generate with: openssl rand -hex 32
# NEVER commit to Git!
MCP_SECRET_TOKEN=

# ── Domain (required) ─────────────────────────────────────────────
# Your public domain – Caddy fetches TLS certificate automatically
# Example: mcp.my-domain.com
DOMAIN=
