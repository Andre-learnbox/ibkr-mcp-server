# ═══════════════════════════════════════════════════════════════════
#  .env – IBKR MCP Stack Konfiguration
#
#  SETUP:
#    1.  cp .env.example .env
#    2.  Alle Pflichtfelder ausfüllen (keine Defaults!)
#    3.  Token generieren: openssl rand -hex 32
#    4.  docker compose up -d
#
#  Paper ↔ Live umschalten:
#    Nur TRADING_MODE und IB_GATEWAY_PORT ändern, dann:
#    docker compose up -d --force-recreate ib-gateway ibkr-mcp-server
# ═══════════════════════════════════════════════════════════════════

# ── IBKR Zugangsdaten (Pflicht) ───────────────────────────────────
TWS_USERID=
TWS_PASSWORD=

# ── Handelsmode (Pflicht) ─────────────────────────────────────────
# Wert: paper  → Simulationskonto (sicher zum Testen)
# Wert: live   → Echtes Konto (Vorsicht!)
TRADING_MODE=paper

# ── IB Gateway API Port (Pflicht – muss zu TRADING_MODE passen!) ──
# Paper-Konto: 4004
# Live-Konto:  4003
#
# WICHTIG: Wenn TRADING_MODE geändert wird, muss dieser Port
#           ebenfalls angepasst werden!
IB_GATEWAY_PORT=4004

# ── Sicherheit: Read-Only API (Pflicht) ───────────────────────────
# yes → Keine Handelsorders möglich (EMPFOHLEN, besonders für Live!)
# no  → Handelsorders möglich (nur wenn explizit benötigt)
#
# Für Live-Konto: IMMER yes!
READ_ONLY_API=yes

# ── IB Gateway Einstellungen ──────────────────────────────────────
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
AUTO_RESTART_TIME=23:45
TIME_ZONE=Europe/Berlin

# VNC Passwort für visuellen Zugang zum IB Gateway (Debugging)
# Leer lassen = kein VNC-Server gestartet
VNC_SERVER_PASSWORD=

# ── MCP Bearer Token (Pflicht) ────────────────────────────────────
# Schützt /mcp* (Perplexity, OpenAI API) und /mcpo* (Open-WebUI)
# Generieren mit: openssl rand -hex 32
# NIEMALS in Git committen!
MCP_SECRET_TOKEN=

# ── Domain (Pflicht) ──────────────────────────────────────────────
# Deine öffentliche Domain – Caddy holt TLS-Zertifikat automatisch
# Beispiel: mcp.meine-domain.de
DOMAIN=
