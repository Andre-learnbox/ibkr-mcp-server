# ═══════════════════════════════════════════════════════════════
#  Caddyfile – IBKR MCP Stack
#
#  Template: __DOMAIN__ wird beim Start durch sed ersetzt.
#  {env.MCP_SECRET_TOKEN} wird von Caddy zur Laufzeit aufgelöst.
#
#  Routing-Logik (vereinfacht, ohne route-Blöcke):
#   1. Erst DENY prüfen (unauthorized → 401)
#   2. Dann PROXY für erlaubte Requests
#   3. Alles andere → 404
# ═══════════════════════════════════════════════════════════════

__DOMAIN__ {

    # ── Logging ───────────────────────────────────────────────
    log {
        output file /var/log/caddy/access.log {
            roll_size     50mb
            roll_keep     5
            roll_keep_for 720h
        }
        format json
        level  INFO
    }

    # ── Sicherheits-Header ────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        -Server
    }

    # ═══════════════════════════════════════════════════════════
    #  /mcp* – DENY: weder Anthropic-IP noch gültiger Bearer
    #
    #  Anthropic Egress-IPs (Claude.ai):
    #  https://docs.claude.com/en/api/ip-addresses
    # ═══════════════════════════════════════════════════════════
    @mcp_deny {
        path /mcp*
        not remote_ip 160.79.104.0/21
        not header Authorization "Bearer {env.MCP_SECRET_TOKEN}"
    }
    handle @mcp_deny {
        respond "Unauthorized" 401
    }

    # ═══════════════════════════════════════════════════════════
    #  /mcpo* – DENY: kein gültiger Bearer-Token
    # ═══════════════════════════════════════════════════════════
    @mcpo_deny {
        path /mcpo*
        not header Authorization "Bearer {env.MCP_SECRET_TOKEN}"
    }
    handle @mcpo_deny {
        respond "Unauthorized" 401
    }

    # ═══════════════════════════════════════════════════════════
    #  /mcp* – PROXY zu ibkr-mcp-server (nach Auth-Check)
    #
    #  Erlaubt: Anthropic-IPs (Claude.ai) + Bearer-Token-Träger
    # ═══════════════════════════════════════════════════════════
    handle /mcp* {
        reverse_proxy ibkr-mcp-server:8000
    }

    # ═══════════════════════════════════════════════════════════
    #  /mcpo* – PROXY zu mcpo (OpenAPI für Open-WebUI)
    #
    #  In Open-WebUI eintragen:
    #    Type: OpenAPI
    #    URL:  https://__DOMAIN__/mcpo/ibkr
    #    Auth: Bearer → MCP_SECRET_TOKEN
    # ═══════════════════════════════════════════════════════════
    handle /mcpo* {
        uri strip_prefix /mcpo
        reverse_proxy mcpo:8001
    }

    # ── Alles andere → 404 ───────────────────────────────────
    respond "Not Found" 404
}
