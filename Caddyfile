# ═══════════════════════════════════════════════════════════════
#  Caddyfile – IBKR MCP Stack
#
#  WICHTIG: Diese Datei ist ein Template!
#  Der Platzhalter __DOMAIN__ wird beim Container-Start durch
#  die DOMAIN-Umgebungsvariable ersetzt (via sed im entrypoint).
#
#  {env.MCP_SECRET_TOKEN} funktioniert direkt in Caddy-Direktiven
#  (nicht im Site-Block-Label), daher dieser gemischte Ansatz.
#
#  Sicherheitskonzept:
#  /mcp*   → Anthropic-IPs (Claude.ai) ODER Bearer-Token
#             → Claude.ai, Perplexity, OpenAI API
#  /mcpo*  → Nur Bearer-Token → Open-WebUI via OpenAPI
#  Alles andere → 404
# ═══════════════════════════════════════════════════════════════

__DOMAIN__ {

    # ── TLS (automatisch via Let's Encrypt) ───────────────────
    # Caddy holt das Zertifikat automatisch wenn DOMAIN gesetzt ist

    # ── Logging ───────────────────────────────────────────────
    log {
        output file /var/log/caddy/access.log {
            roll_size     50mb
            roll_keep     5
            roll_keep_for 720h
        }
        format json
        level  INFO
    }

    # ── Sicherheits-Header ────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        -Server
    }

    # ═══════════════════════════════════════════════════════════
    #  ENDPUNKT 1: /mcp  (direkter MCP Streamable HTTP)
    #
    #  Erlaubt:
    #   a) Anthropic-Egress-IPs  → Claude.ai (kein Token nötig)
    #      Quelle: https://docs.claude.com/en/api/ip-addresses
    #   b) Gültiger Bearer-Token → Perplexity, OpenAI API
    # ═══════════════════════════════════════════════════════════
    route /mcp* {

        @anthropic_ip remote_ip 160.79.104.0/21

        @valid_bearer header Authorization "Bearer {env.MCP_SECRET_TOKEN}"

        @unauthorized {
            not remote_ip 160.79.104.0/21
            not header Authorization "Bearer {env.MCP_SECRET_TOKEN}"
        }

        # Claude.ai: via Anthropic-IP durchlassen
        handle @anthropic_ip {
            reverse_proxy ibkr-mcp-server:8000
        }

        # Perplexity / OpenAI API: via Bearer-Token
        handle @valid_bearer {
            reverse_proxy ibkr-mcp-server:8000
        }

        # Alles andere: 401
        handle @unauthorized {
            respond "Unauthorized" 401
        }
    }

    # ═══════════════════════════════════════════════════════════
    #  ENDPUNKT 2: /mcpo  (OpenAPI via MCPO für Open-WebUI)
    #
    #  Nur mit Bearer-Token erreichbar.
    #  In Open-WebUI als "OpenAPI Tool Server" eintragen:
    #    URL:  https://__DOMAIN__/mcpo/ibkr
    #    Auth: Bearer → MCP_SECRET_TOKEN
    # ═══════════════════════════════════════════════════════════
    route /mcpo* {

        @valid_bearer header Authorization "Bearer {env.MCP_SECRET_TOKEN}"

        @unauthorized {
            not header Authorization "Bearer {env.MCP_SECRET_TOKEN}"
        }

        handle @valid_bearer {
            uri strip_prefix /mcpo
            reverse_proxy mcpo:8001
        }

        handle @unauthorized {
            respond "Unauthorized" 401
        }
    }

    # ── Alle anderen Pfade: 404 ───────────────────────────────
    handle {
        respond "Not Found" 404
    }
}
