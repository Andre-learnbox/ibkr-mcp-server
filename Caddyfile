# ═══════════════════════════════════════════════════════════════
#  Caddyfile – IBKR MCP Stack
#
#  Template: __DOMAIN__ wird beim Start durch sed ersetzt.
#  {env.MCP_SECRET_TOKEN} wird von Caddy zur Laufzeit aufgelöst.
#
#  Routing-Reihenfolge (Reihenfolge ist in Caddy entscheidend!):
#   1. @mcp_deny   → 401 wenn /mcp (exkl. /mcpo) ohne Auth
#   2. @mcpo_deny  → 401 wenn /mcpo ohne Bearer
#   3. handle /mcpo* → proxy mcpo:8001  (VOR /mcp* – wichtig!)
#   4. handle /mcp*  → proxy ibkr-mcp-server:8000
#   5. handle {}     → 404 für alles andere
# ═══════════════════════════════════════════════════════════════

__DOMAIN__ {

    # ── Logging (stdout – Docker-kompatibel, kein Verzeichnis nötig)
    log {
        output stdout
        format json
        level  INFO
    }

    # ── Sicherheits-Header ────────────────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        -Server
    }

    # ═══════════════════════════════════════════════════════════
    #  DENY /mcp* (exkl. /mcpo*): weder Anthropic-IP noch Bearer
    #
    #  "not path /mcpo*" verhindert, dass dieser Matcher
    #  fälschlicherweise auch /mcpo-Requests trifft.
    #
    #  Anthropic Egress-IPs (Claude.ai):
    #  https://docs.claude.com/en/api/ip-addresses
    # ═══════════════════════════════════════════════════════════
    @mcp_deny {
        path     /mcp*
        not path /mcpo*
        not remote_ip 160.79.104.0/21
        not header Authorization "Bearer {env.MCP_SECRET_TOKEN}"
    }
    handle @mcp_deny {
        respond "Unauthorized" 401
    }

    # ═══════════════════════════════════════════════════════════
    #  DENY /mcpo*: kein gültiger Bearer-Token
    # ═══════════════════════════════════════════════════════════
    @mcpo_deny {
        path /mcpo*
        not header Authorization "Bearer {env.MCP_SECRET_TOKEN}"
    }
    handle @mcpo_deny {
        respond "Unauthorized" 401
    }

    # ═══════════════════════════════════════════════════════════
    #  PROXY /mcpo* → mcpo:8001 (OpenAPI für Open-WebUI)
    #
    #  MUSS vor handle /mcp* stehen! /mcpo startet mit /mcp,
    #  daher würde es sonst an den falschen Backend weitergeleitet.
    #
    #  In Open-WebUI eintragen:
    #    Type: OpenAPI
    #    URL:  https://__DOMAIN__/mcpo/ibkr
    #    Auth: Bearer → MCP_SECRET_TOKEN
    # ═══════════════════════════════════════════════════════════
    handle /mcpo* {
        uri strip_prefix /mcpo
        reverse_proxy mcpo:8001
    }

    # ═══════════════════════════════════════════════════════════
    #  PROXY /mcp* → ibkr-mcp-server:8000
    #
    #  Erlaubt: Anthropic-IPs (Claude.ai) + gültiger Bearer-Token
    #  (Perplexity, OpenAI API)
    # ═══════════════════════════════════════════════════════════
    handle /mcp* {
        reverse_proxy ibkr-mcp-server:8000
    }

    # ── Alles andere → 404 ───────────────────────────────────
    handle {
        respond "Not Found" 404
    }
}
